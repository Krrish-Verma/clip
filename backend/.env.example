# Database (secret)
DATABASE_URL=jdbc:postgresql://localhost:5432/clip
DATABASE_USERNAME=clip
DATABASE_PASSWORD=clip-local-only

# Clerk backend verification (secret/configuration)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:3000,http://localhost:3000

# Private S3-compatible object storage (all secret except endpoints/region/bucket)
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clip
S3_ACCESS_KEY=clip-local
S3_SECRET_KEY=clip-local-only

# Application
FRONTEND_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
WORKER_ENABLED=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT=15m
MAX_VIDEOS_PER_USER=5
MAX_VIDEO_BYTES=209715200
MAX_STORAGE_BYTES_PER_USER=1073741824
MAX_VIDEO_DURATION_SECONDS=600
