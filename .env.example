# Public values embedded in the browser bundle. These are not secrets.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only secret used by Clerk middleware. Never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Optional stable encryption key when self-hosting multiple Next.js instances.
# Generate a base64-encoded 32-byte value and keep it secret.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Docker Compose reads these backend verification values from the root .env.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:3000,http://localhost:3000
